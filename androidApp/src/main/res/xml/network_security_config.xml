<?xml version="1.0" encoding="utf-8"?>
<!--
  Política de red de las builds **publicadas**: sólo TLS.

  La API de producción es HTTPS, así que aquí no hay nada que permitir en claro.
  El tráfico HTTP de desarrollo se habilita en la build de debug, que sobrescribe
  este archivo (`src/debug/res/xml/network_security_config.xml`).

  Antes esto era una lista de IPs de desarrollo (`192.168.10.107`). Se quedó
  obsoleta en cuanto el router reasignó la IP (pasó a `.105`) y el síntoma era
  "Sin conexión" en el device real, sin ninguna pista de que el bloqueo venía de
  la política de red. Una lista de IPs que cambian no es una configuración.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
