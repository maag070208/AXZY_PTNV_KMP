-- Consultas de la entidad RecurringRoute.

selectActiveRecurring:
SELECT * FROM recurring_configurations WHERE active = 1 ORDER BY title;

selectActiveRecurringByClient:
SELECT * FROM recurring_configurations WHERE active = 1 AND client_id = ? ORDER BY title;

selectRecurringLocations:
SELECT * FROM recurring_locations WHERE recurring_configuration_id = ? ORDER BY sort_order ASC;

selectRecurringTasks:
SELECT * FROM recurring_tasks WHERE recurring_location_id = ? ORDER BY created_at ASC;
